# Copy to .env and fill in. Everything has a working default except the LLM key.

# ---- Server ----------------------------------------------------------------
PORT=4000
# Restrict in production, e.g. https://lacy.example.com
CORS_ORIGIN=*

# ---- Database --------------------------------------------------------------
# Lacy stores everything in one SQLite file; it is created on first start.
# Relative paths are resolved from the repository root; absolute paths work too.
DB_FILE=server/data/lacy.sqlite

# ---- Tour generation (LLM) -------------------------------------------------
# gemini | openai (any OpenAI-compatible /chat/completions endpoint)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# gemini-flash-latest follows Google's current Flash model, so it keeps working
# when Google retires an older one. Pin a version (e.g. gemini-3.8-flash) if you
# need answers to stay the same over time.
GEMINI_MODEL=gemini-flash-latest

# Works with OpenAI, Azure OpenAI proxies, vLLM, Ollama, or a company gateway.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ---- Speech to text (voice tours) ------------------------------------------
# elevenlabs | google
STT_PROVIDER=elevenlabs
STT_LANGUAGE=en-US
# Google only: path to a service account key file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# ---- Podcasts (ElevenLabs text to speech) ----------------------------------
ELEVENLABS_API_KEY=
# Where podcast audio files are written (relative paths are from the repo root).
AUDIO_DIR=server/data/audio
# ELEVENLABS_EXPERT_VOICE_ID=uYXf8XasLslADfZ2MB4u
# ELEVENLABS_JUNIOR_VOICE_ID=UgBBYS2sOqTuMpoF3BR0

# ---- Advanced --------------------------------------------------------------
# Let the server read project files from its own disk when the extension sends
# only paths. Only for a server running on the same machine as the editor.
# ALLOW_LOCAL_FILE_ACCESS=false
